PORT=5000

# Учётные данные администратора
ADMIN_LOGIN=admin
ADMIN_PASSWORD=замените-на-надёжный-пароль

# Секрет для подписи токенов: минимум 32 символа, сгенерируйте командой npm run gen:secret
AUTH_SECRET=замените-на-случайную-строку

# Разрешённые источники через запятую
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:8000

# Сколько прокси доверять при определении IP (1 — если перед Node стоит nginx).
# Оставьте закомментированным при прямом доступе, иначе лимиты можно обойти подделкой X-Forwarded-For.
# TRUST_PROXY=1
